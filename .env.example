# ---- Client-safe (bundled into the apps) ----
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---- Server only (apps/api). NEVER prefix with EXPO_PUBLIC_ ----
NODE_ENV=development
API_PORT=8787
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# mock = dev-only demo accounts; the API refuses to start with mock in production
AUTH_MODE=mock
AI_PROVIDER=mock
AI_API_KEY=
AI_DAILY_LIMIT_GUEST=3
AI_DAILY_LIMIT_CUSTOMER=20
