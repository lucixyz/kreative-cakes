{
  "name": "kreative-cakes",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:customer": "pnpm --filter @cakeshop/customer start",
    "dev:customer:web": "pnpm --filter @cakeshop/customer web",
    "dev:admin": "pnpm --filter @cakeshop/admin web",
    "dev:api": "pnpm --filter @cakeshop/api dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "build": "turbo run build",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "e2e:auth": "node tests/e2e/auth-redirects.mjs"
  },
  "devDependencies": {
    "@cakeshop/config": "workspace:*",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "playwright-core": "^1.63.0",
    "turbo": "^2.11.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
